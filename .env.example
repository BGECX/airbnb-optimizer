# === Application ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# === API Backend Python (FastAPI) ===
API_BASE_URL=http://localhost:8000

# === Clerk Authentication ===
# Récupérer sur https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace_with_clerk_publishable_key
CLERK_SECRET_KEY=replace_with_clerk_secret_key

# URLs de redirection Clerk
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# === Supabase ===
# Récupérer sur https://supabase.com → Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_supabase_service_role_key
# (Service Role Key = secret, ne jamais exposer côté client)

# === Stripe ===
STRIPE_SECRET_KEY=replace_with_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=replace_with_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=replace_with_stripe_webhook_secret
STRIPE_PRICE_STARTER=replace_with_starter_price_id
STRIPE_PRICE_PRO=replace_with_pro_price_id

# === i18n ===
NEXT_PUBLIC_DEFAULT_LOCALE=fr
