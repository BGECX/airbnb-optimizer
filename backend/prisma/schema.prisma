  dateFin      DateTime @map("date_fin")
  couleur      String   @default("#2563eb")
  dependanceId String?  @map("dependance_id")
  ressources   String[] // IDs des employés
  avancement   Decimal  @default(0) @db.Decimal(5, 2)
  createdById  String   @map("created_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  clientSyncId String?  @unique @map("client_sync_id")

  chantier  Chantier @relation(fields: [chantierId], references: [id])
  createdBy User     @relation(fields: [createdById], references: [id])

  @@map("taches_gantt")
}

model JalonGantt {
  id          String   @id @default(uuid())
  nom         String
  chantierId  String   @map("chantier_id")
  date        DateTime
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  chantier Chantier @relation(fields: [chantierId], references: [id])

  @@map("jalons_gantt")
}

// ==================== PHOTOS ====================
model Photo {
  id           String     @id @default(uuid())
  chantierId   String     @map("chantier_id")
  url          String
  thumbnailUrl String?    @map("thumbnail_url")
  lieu         String?
  description  String?
  phase        PhotoPhase @default(PENDANT)
  zone         String?
  ouvrageId    String?    @map("ouvrage_id")
  annotations  Json?
  hashSha256   String?    @map("hash_sha256")
  clientSyncId String?    @unique @map("client_sync_id")
  latitude     Decimal?   @db.Decimal(10, 8)
  longitude    Decimal?   @db.Decimal(11, 8)
  datePrise    DateTime   @default(now()) @map("date_prise")
  uploadedById String     @map("uploaded_by_id")
  isSync       Boolean    @default(false) @map("is_sync")
  createdAt    DateTime   @default(now()) @map("created_at")

  chantier   Chantier @relation(fields: [chantierId], references: [id])
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
  ouvrage    Ouvrage? @relation(fields: [ouvrageId], references: [id])

  @@map("photos")
}

enum PhotoPhase {
  AVANT
  PENDANT
  APRES
  RESERVE
  SAV
}

model DocumentChantier {
  id         String               @id @default(uuid())
  chantierId String               @map("chantier_id")
  type       DocumentChantierType
  phase      PhotoPhase?
  zone       String?
  nom        String
  url        String
  mimeType   String?              @map("mime_type")
  taille     Int?
  version    Int                  @default(1)
  hashSha256 String?              @map("hash_sha256")
  metadata   Json?
  createdAt  DateTime             @default(now()) @map("created_at")

  chantier Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)

  @@index([chantierId, type, zone])
  @@map("documents_chantiers")
}

enum DocumentChantierType {
  PLAN
  PV
  DOE
  DIAGNOSTIC
  DEVIS
  FACTURE
  BON_LIVRAISON
  NOTICE
  AUTRE
}

// ==================== BIBLIOTHÈQUE ====================
model Ouvrage {
  id                   String   @id @default(uuid())
  reference            String   @unique
  designation          String
  unite                String
  prixUnitaireHt       Decimal  @map("prix_unitaire_ht") @db.Decimal(12, 2)
  dateMaj              DateTime @default(now()) @map("date_maj")
  categorie            String?
  sousCategorie        String?  @map("sous_categorie")
  debourseSec          Decimal  @default(0) @map("debourse_sec") @db.Decimal(12, 2)
  coefficientVente     Decimal  @default(1) @map("coefficient_vente") @db.Decimal(8, 4)
  tempsPoseHeures      Decimal? @map("temps_pose_heures") @db.Decimal(8, 3)
  rendement            Decimal? @db.Decimal(10, 3)
  descriptionTechnique String?  @map("description_technique")
  isActif              Boolean  @default(true) @map("is_actif")
  updatedAt            DateTime @updatedAt @map("updated_at")

  composants      ComposantOuvrage[]
  historiquesPrix HistoriquePrixOuvrage[]
  postesDpgf      PosteDpgf[]
  photos          Photo[]
  createdAt       DateTime                @default(now()) @map("created_at")

  @@map("ouvrages")
}

model ComposantOuvrage {
  id           String        @id @default(uuid())
  ouvrageId    String        @map("ouvrage_id")
  type         RessourceType
  designation  String
  unite        String
  quantite     Decimal       @db.Decimal(12, 4)
  prixUnitaire Decimal       @map("prix_unitaire") @db.Decimal(12, 4)
  tauxPerte    Decimal       @default(0) @map("taux_perte") @db.Decimal(5, 2)
  fournisseur  String?
  ordre        Int           @default(0)

  ouvrage Ouvrage @relation(fields: [ouvrageId], references: [id], onDelete: Cascade)

  @@index([ouvrageId, ordre])
  @@map("composants_ouvrages")
}

enum RessourceType {
  MATERIAU
  MAIN_OEUVRE
  MATERIEL
  SOUS_TRAITANCE
}

model HistoriquePrixOuvrage {
  id          String   @id @default(uuid())
  ouvrageId   String   @map("ouvrage_id")
  prixAchat   Decimal  @map("prix_achat") @db.Decimal(12, 2)
  prixVente   Decimal  @map("prix_vente") @db.Decimal(12, 2)
  fournisseur String?
  dateEffet   DateTime @default(now()) @map("date_effet")
  commentaire String?

  ouvrage Ouvrage @relation(fields: [ouvrageId], references: [id], onDelete: Cascade)

  @@index([ouvrageId, dateEffet])
  @@map("historiques_prix_ouvrages")
}

model Materiau {
  id             String   @id @default(uuid())
  reference      String   @unique
  designation    String
  fournisseurId  String?  @map("fournisseur_id")
  prixUnitaireHt Decimal  @map("prix_unitaire_ht") @db.Decimal(12, 2)
  stock          Decimal  @default(0) @db.Decimal(10, 2)
  unite          String
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("materiaux")
}

// ==================== BANQUE ====================
model OperationBancaire {
  id              String        @id @default(uuid())
  type            OperationType
  date            DateTime
  libelle         String
  montant         Decimal       @db.Decimal(12, 2)
  banque          String
  modeReglement   String?       @map("mode_reglement")
  compteComptable String?       @map("compte_comptable")
  isRapproche     Boolean       @default(false) @map("is_rapproche")
  justificatifUrl String?       @map("justificatif_url")
  createdById     String        @map("created_by_id")
  createdAt       DateTime      @default(now()) @map("created_at")

  createdBy User @relation(fields: [createdById], references: [id])

  @@map("operations_bancaires")
}

enum OperationType {
  DEBIT
  CREDIT
}

// ==================== COMPTABILITÉ ====================
model DeclarationTVA {
  id              String            @id @default(uuid())
  periode         String // T1-2026, T2-2026, etc.
  tvaCollectee    Decimal           @map("tva_collectee") @db.Decimal(12, 2)
  tvaDeductible   Decimal           @map("tva_deductible") @db.Decimal(12, 2)
  montantAPayer   Decimal           @map("montant_a_payer") @db.Decimal(12, 2)
  isCredit        Boolean           @default(false) @map("is_credit")
  dateEcheance    DateTime          @map("date_echeance")
  dateDeclaration DateTime?         @map("date_declaration")
  statut          DeclarationStatut @default(A_DECLARER)
  createdAt       DateTime          @default(now()) @map("created_at")

  @@map("declarations_tva")
}

enum DeclarationStatut {
  A_DECLARER
  DECLAREE
  PAYEE
  EN_RETARD
}

model EcritureComptable {
  id          String   @id @default(uuid())
  journal     String
  date        DateTime
  numeroPiece String   @map("numero_piece")
  compte      String
  libelle     String
  debit       Decimal? @db.Decimal(12, 2)
  credit      Decimal? @db.Decimal(12, 2)
  lettrage    String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ecritures_comptables")
}

// ==================== COPROPRIÉTÉS ====================
model Copropriete {
  id               String    @id @default(uuid())
  nom              String
  adresse          String
  codePostal       String    @map("code_postal")
  ville            String
  nombreLots       Int       @map("nombre_lots")
  dateConstruction DateTime? @map("date_construction")
  syndicNom        String?   @map("syndic_nom")
  syndicContact    String?   @map("syndic_contact")
  observations     String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  lots        Lot[]
  diagnostics Diagnostic[]
  dtgs        DTG[]
  evenements  EvenementHistorique[]

  @@map("coproprietes")
}

model Lot {
  id                  String       @id @default(uuid())
  coproprieteId       String       @map("copropriete_id")
  numero              String
  designation         String?
  tantiemes           Int
  surface             Decimal?     @db.Decimal(8, 2)
  derniersTravaux     String?      @map("derniers_travaux")
  pointSituation      LotSituation @default(NON_COMMENCE) @map("point_situation")
  montantConsignation Decimal?     @map("montant_consignation") @db.Decimal(12, 2)
  dpeClasse           String?      @map("dpe_classe")
  dpeConsommation     Decimal?     @map("dpe_consommation") @db.Decimal(8, 2)
  dpeEmissions        Decimal?     @map("dpe_emissions") @db.Decimal(8, 2)
  dpeDate             DateTime?    @map("dpe_date")
  createdAt           DateTime     @default(now()) @map("created_at")

  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])
  chantier    Chantier[]

  @@map("lots")
}

enum LotSituation {
  OK
  A_CONTROLER
  TRAVAUX_EN_COURS
  CONSIGNATION
  NON_COMMENCE
}

model Diagnostic {
  id                String               @id @default(uuid())
  coproprieteId     String               @map("copropriete_id")
  type              DiagnosticType
  lotId             String?              @map("lot_id")
  dateRealisation   DateTime             @map("date_realisation")
  dateValidite      DateTime             @map("date_validite")
  diagnostiqueur    String?
  numeroAttestation String?              @map("numero_attestation")
  conclusion        DiagnosticConclusion @default(CONFORME)
  observations      String?
  documentUrl       String?              @map("document_url")
  createdAt         DateTime             @default(now()) @map("created_at")

  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])

  @@map("diagnostics")
}

enum DiagnosticType {
  AMIANTE_DAPP
  PLOMB_CREP
  ELECTRICITE
  GAZ
  TERMITES
  ERP_ACCESSIBILITE
  LOI_CARREZ
  ETAT_PARASITAIRE
  DPE
  ERNMT
}

enum DiagnosticConclusion {
  CONFORME
  NON_CONFORME
  A_COMPLETER
}

model DTG {
  id              String   @id @default(uuid())
  coproprieteId   String   @map("copropriete_id")
  dateRealisation DateTime @map("date_realisation")
  dateValidite    DateTime @map("date_validite")
  diagnostiqueur  String?
  observations    String?
  isConforme      Boolean  @default(true) @map("is_conforme")
  documentUrl     String?  @map("document_url")
  createdAt       DateTime @default(now()) @map("created_at")

  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])

  @@map("dtgs")
}

model EvenementHistorique {
  id            String        @id @default(uuid())
  coproprieteId String        @map("copropriete_id")
  date          DateTime
  type          EvenementType
  titre         String
  description   String?
  cout          Decimal?      @db.Decimal(12, 2)
  documents     String[] // URLs des documents
  createdAt     DateTime      @default(now()) @map("created_at")

  copropriete Copropriete @relation(fields: [coproprieteId], references: [id])

  @@map("evenements_historiques")
}

enum EvenementType {
  TRAVAUX
  DIAGNOSTIC
  SINISTRE
  AG_COPRO
  AUTRE
}

// ==================== CARNETS D'ENTRETIEN ====================
model CarnetEntretien {
  id             String    @id @default(uuid())
  numero         String    @unique
  chantierId     String    @map("chantier_id")
  description    String
  dateReception  DateTime  @map("date_reception")
  dureeGarantie  Int       @default(10) @map("duree_garantie") // en années
  qrCodeUrl      String?   @map("qr_code_url")
  pdfUrl         String?   @map("pdf_url")
  isEnvoyeClient Boolean   @default(false) @map("is_envoye_client")
  dateEnvoi      DateTime? @map("date_envoi")
  createdAt      DateTime  @default(now()) @map("created_at")

  chantier Chantier @relation(fields: [chantierId], references: [id])

  @@map("carnets_entretien")
}

// ==================== NOTES & JOURNAL ====================
model Note {
  id          String   @id @default(uuid())
  chantierId  String?  @map("chantier_id")
  contenu     String
  type        NoteType @default(TEXT)
  createdById String   @map("created_by_id")
  isSync      Boolean  @default(false) @map("is_sync")
  createdAt   DateTime @default(now()) @map("created_at")

  chantier  Chantier? @relation(fields: [chantierId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@map("notes")
}

enum NoteType {
  TEXT
  VOCAL
  PHOTO
}

// ==================== DOCUMENTS JURIDIQUES ====================
model DocumentJuridique {
  id        String   @id @default(uuid())
  nom       String
  type      String // CGV, contrat_type, lettre_relance, mise_demeure
  contenu   String   @db.Text
  isModele  Boolean  @default(false) @map("is_modele")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("documents_juridiques")
}
