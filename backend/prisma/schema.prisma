generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== UTILISATEURS & AUTH ====================
model User {
  id          String    @id @default(uuid())
  email       String    @unique
  password    String
  firstName   String    @map("first_name")
  lastName    String    @map("last_name")
  role        UserRole  @default(USER)
  isActive    Boolean   @default(true) @map("is_active")
  avatarUrl   String?   @map("avatar_url")
  phone       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  lastLoginAt DateTime? @map("last_login_at")

  // Relations
  devisCreated           Devis[]
  facturesCreated        Facture[]
  chantiersManaged       Chantier[]
  photosUploaded         Photo[]
  notesCreated           Note[]
  operationsCreated      OperationBancaire[]
  contratsCreated        Contrat[]
  tachesCreated          TacheGantt[]
  bonsCreated            BonIntervention[]
  dpgfsCreated           Dpgf[]
  visitesCreated         VisiteTechnique[]
  diagnosticsBatiCreated DiagnosticBati[]
  tracesBatiCreated      TraceBati[]
  depensesCreated        DepenseChantier[]
  pointagesValides       Pointage[]           @relation("PointagesValides")
  employe                Employe?
  journauxAudit          JournalAudit[]
  analysesChiffrage      AnalyseChiffrage[]
  refreshTokens          RefreshToken[]
  passwordResetTokens    PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id")
  userAgent    String?   @map("user_agent")
  adresseIp    String?   @map("adresse_ip")
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}

enum UserRole {
  ADMIN
  MANAGER
  CHEF_CHANTIER
  COMPTABLE
  COMPAGNON
  USER
}

model JournalAudit {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  methode    String
  chemin     String
  statutHttp Int      @map("statut_http")
  adresseIp  String?  @map("adresse_ip")
  userAgent  String?  @map("user_agent")
  champs     String[]
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([chemin, createdAt])
  @@map("journal_audit")
}

// ==================== PARAMÈTRES ENTREPRISE ====================
model ParametreEntreprise {
  id               String   @id @default(uuid())
  raisonSociale    String   @map("raison_sociale")
  siret            String?
  siren            String?
  tvaIntra         String?  @map("tva_intra")
  adresse          String?
  codePostal       String?  @map("code_postal")
  ville            String?
  telephone        String?
  email            String?
  siteWeb          String?  @map("site_web")
  logoUrl          String?  @map("logo_url")
  couleurPrimary   String   @default("#2563eb") @map("couleur_primary")
  couleurSecondary String   @default("#f59e0b") @map("couleur_secondary")
  cgv              String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("parametres_entreprise")
}

model ParametreNumerotation {
  id           String   @id @default(uuid())
  type         String // devis, facture, chantier, commande, acompte, situation, avoir
  prefixe      String   @default("")
  numeroActuel Int      @default(0) @map("numero_actuel")
  format       String   @default("{PREFIX}{YYYY}-{NUMERO}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([type])
  @@map("parametres_numerotation")
}

model ParametreTVA {
  id        String   @id @default(uuid())
  nom       String
  taux      Decimal  @db.Decimal(5, 2)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("parametres_tva")
}

model ParametreBanque {
  id              String   @id @default(uuid())
  nom             String
  iban            String
  bic             String
  compteComptable String?  @map("compte_comptable")
  isDefault       Boolean  @default(false) @map("is_default")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("parametres_banques")
}

model Assurance {
  id          String   @id @default(uuid())
  type        String // RC_decennale, RC_exploitation, DO, etc.
  police      String
  compagnie   String
  couverture  String?
  dateDebut   DateTime @map("date_debut")
  dateFin     DateTime @map("date_fin")
  documentUrl String?  @map("document_url")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("assurances")
}

// ==================== CONTACTS ====================
model Client {
  id           String     @id @default(uuid())
  type         ClientType @default(PARTICULIER)
  nom          String
  siret        String?    @unique
  siren        String?
  tvaIntra     String?    @map("tva_intra")
  adresse      String?
  codePostal   String?    @map("code_postal")
  ville        String?
  telephone    String?
  email        String?
  contactNom   String?    @map("contact_nom")
  contactTel   String?    @map("contact_tel")
  contactEmail String?    @map("contact_email")
  notes        String?
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  // Relations
  devis      Devis[]
  factures   Facture[]
  chantiers  Chantier[]
  acomptes   Acompte[]
  situations Situation[]
  avoirs     Avoir[]
  prospects  Prospect[]
  visites    VisiteTechnique[]

  @@map("clients")
}

model ApporteurAffaires {
  id              String        @id @default(uuid())
  type            ApporteurType @default(AUTRE)
  nom             String
  siret           String?       @unique
  adresse         String?
  codePostal      String?       @map("code_postal")
  ville           String?
  telephone       String?
  email           String?
  contactNom      String?       @map("contact_nom")
  referenceMandat String?       @map("reference_mandat")
  commissionPct   Decimal?      @map("commission_pct") @db.Decimal(5, 2)
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  devis Devis[]

  @@map("apporteurs_affaires")
}

enum ApporteurType {
  AGENCE_IMMOBILIERE
  APPORTEUR_AFFAIRES
  ARCHITECTE
  MAITRE_OEUVRE
  SYNDIC
  AUTRE
}

enum ClientType {
  PARTICULIER
  ENTREPRISE
  COPROPRIETE
  COLLECTIVITE
}

model Fournisseur {
  id                 String   @id @default(uuid())
  raisonSociale      String   @map("raison_sociale")
  siret              String?
  adresse            String?
  codePostal         String?  @map("code_postal")
  ville              String?
  telephone          String?
  email              String?
  specialite         String?
  delaiLivraison     String?  @map("delai_livraison")
  conditionsPaiement String?  @map("conditions_paiement")
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")

  commandes     Commande[]
  facturesFourn FactureFournisseur[]

  @@map("fournisseurs")
}

model SousTraitant {
  id                 String    @id @default(uuid())
  raisonSociale      String    @map("raison_sociale")
  siret              String?
  specialite         String?
  adresse            String?
  telephone          String?
  email              String?
  urssafDate         DateTime? @map("urssaf_date")
  urssafValidite     DateTime? @map("urssaf_validite")
  urssafDocumentUrl  String?   @map("urssaf_document_url")
  assuranceRc        String?   @map("assurance_rc")
  assuranceRcMontant Decimal?  @map("assurance_rc_montant") @db.Decimal(12, 2)
  decennaleDate      DateTime? @map("decennale_date")
  decennaleValidite  DateTime? @map("decennale_validite")
  isActive           Boolean   @default(true) @map("is_active")
  createdAt          DateTime  @default(now()) @map("created_at")

  affectations AffectationSousTraitant[]

  @@map("sous_traitants")
}

model Prospect {
  id                  String         @id @default(uuid())
  type                ClientType     @default(PARTICULIER)
  nom                 String
  contactNom          String?        @map("contact_nom")
  telephone           String?
  email               String?
  projet              String?
  budgetEstime        Decimal?       @map("budget_estime") @db.Decimal(12, 2)
  dateContact         DateTime       @map("date_contact")
  statut              ProspectStatut @default(PREMIER_CONTACT)
  notes               String?
  convertedToClientId String?        @map("converted_to_client_id")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  convertedToClient Client?           @relation(fields: [convertedToClientId], references: [id])
  visites           VisiteTechnique[]

  @@map("prospects")
}

enum ProspectStatut {
  PREMIER_CONTACT
  VISITE_PLANIFIEE
  VISITE_REALISEE
  CHIFFRAGE
  DEVIS_DEMANDE
  DEVIS_ENVOYE
  NEGOCIATION
  GAGNE
  PERDU
}

// ==================== CHANTIERS ====================
model Chantier {
  id              String         @id @default(uuid())
  reference       String         @unique
  clientId        String         @map("client_id")
  objet           String
  adresse         String?
  codePostal      String?        @map("code_postal")
  ville           String?
  dateDebutPrevue DateTime?      @map("date_debut_prevue")
  dateFinPrevue   DateTime?      @map("date_fin_prevue")
  dateDebutReelle DateTime?      @map("date_debut_reelle")
  dateFinReelle   DateTime?      @map("date_fin_reelle")
  montantPrevu    Decimal?       @map("montant_prevu") @db.Decimal(12, 2)
  montantRealise  Decimal?       @map("montant_realise") @db.Decimal(12, 2)
  description     String?
  statut          ChantierStatut @default(PREPARATION)
  avancement      Decimal        @default(0) @db.Decimal(5, 2)
  responsableId   String?        @map("responsable_id")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  // Relations
  client                Client                    @relation(fields: [clientId], references: [id])
  responsable           User?                     @relation(fields: [responsableId], references: [id])
  devis                 Devis[]
  factures              Facture[]
  acomptes              Acompte[]
  situations            Situation[]
  commandes             Commande[]
  photos                Photo[]
  tachesGantt           TacheGantt[]
  jalonsGantt           JalonGantt[]
  lots                  Lot[]
  carnets               CarnetEntretien[]
  notesChantier         Note[]
  dpgfs                 Dpgf[]
  visites               VisiteTechnique[]
  diagnosticsBati       DiagnosticBati[]
  aleas                 AleaChantier[]
  travauxConservatoires TravailConservatoire[]
  tracesBati            TraceBati[]
  reception             ReceptionChantier?
  savTickets            SavTicket[]
  retenuesGarantie      RetenueGarantie[]
  budgets               BudgetChantier[]
  depenses              DepenseChantier[]
  sousTraitants         AffectationSousTraitant[]
  documents             DocumentChantier[]
  pointages             Pointage[]
  bonsIntervention      BonIntervention[]
  planningEntries       PlanningEntry[]
  FactureFournisseur    FactureFournisseur[]

  @@map("chantiers")
}

enum ChantierStatut {
  PREPARATION
  EN_COURS
  SUSPENDU
  TERMINE
  LIVRE
  ANNULE
}

// ==================== RÉNOVATION DU BÂTI ANCIEN ====================
model VisiteTechnique {
  id           String       @id @default(uuid())
  prospectId   String?      @map("prospect_id")
  clientId     String?      @map("client_id")
  chantierId   String?      @map("chantier_id")
  datePrevue   DateTime     @map("date_prevue")
  dateRealisee DateTime?    @map("date_realisee")
  statut       VisiteStatut @default(PLANIFIEE)
  adresse      String?
  objet        String
  compteRendu  String?      @map("compte_rendu")
  createdById  String       @map("created_by_id")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  prospect    Prospect?        @relation(fields: [prospectId], references: [id])
  client      Client?          @relation(fields: [clientId], references: [id])
  chantier    Chantier?        @relation(fields: [chantierId], references: [id])
  createdBy   User             @relation(fields: [createdById], references: [id])
  diagnostics DiagnosticBati[]

  @@index([prospectId, datePrevue])
  @@index([chantierId, datePrevue])
  @@map("visites_techniques")
}

enum VisiteStatut {
  PLANIFIEE
  REALISEE
  ANNULEE
}

model DiagnosticBati {
  id             String            @id @default(uuid())
  chantierId     String            @map("chantier_id")
  visiteId       String?           @map("visite_id")
  zone           String
  element        ElementBati
  materiau       String?
  pathologie     String
  gravite        GraviteDiagnostic @default(MODEREE)
  urgence        Boolean           @default(false)
  preconisations String?
  etatAvant      String?           @map("etat_avant")
  createdById    String            @map("created_by_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  chantier              Chantier               @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  visite                VisiteTechnique?       @relation(fields: [visiteId], references: [id])
  createdBy             User                   @relation(fields: [createdById], references: [id])
  travauxConservatoires TravailConservatoire[]

  @@index([chantierId, zone])
  @@map("diagnostics_bati")
}

enum ElementBati {
  FONDATIONS
  MURS_PIERRE
  MACONNERIE
  ENDUITS_CHAUX
  CHARPENTE
  PLANCHER
  COUVERTURE
  FACADE
  MENUISERIE
  HUMIDITE
  RESEAUX
  AUTRE
}

enum GraviteDiagnostic {
  MINEURE
  MODEREE
  IMPORTANTE
  CRITIQUE
}

model AleaChantier {
  id               String        @id @default(uuid())
  chantierId       String        @map("chantier_id")
  categorie        AleaCategorie
  description      String
  probabilite      Int           @default(1)
  impact           Int           @default(1)
  statut           AleaStatut    @default(IDENTIFIE)
  coutEstime       Decimal?      @map("cout_estime") @db.Decimal(12, 2)
  coutReel         Decimal?      @map("cout_reel") @db.Decimal(12, 2)
  delaiJoursEstime Int?          @map("delai_jours_estime")
  mesures          String?
  detectedAt       DateTime      @default(now()) @map("detected_at")
  resolvedAt       DateTime?     @map("resolved_at")

  chantier Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)

  @@index([chantierId, statut])
  @@map("aleas_chantiers")
}

enum AleaCategorie {
  STRUCTURE
  HUMIDITE
  MATERIAUX_REEMPLOI
  RESEAUX
  AMIANTE_PLOMB
  ACCES
  METEO
  ADMINISTRATIF
  AUTRE
}

enum AleaStatut {
  IDENTIFIE
  ANALYSE
  TRAITE
  ACCEPTE
  CLOTURE
}

model TravailConservatoire {
  id           String                     @id @default(uuid())
  chantierId   String                     @map("chantier_id")
  diagnosticId String?                    @map("diagnostic_id")
  designation  String
  motif        String
  statut       TravailConservatoireStatut @default(A_FAIRE)
  datePrevue   DateTime?                  @map("date_prevue")
  dateRealisee DateTime?                  @map("date_realisee")
  coutReel     Decimal?                   @map("cout_reel") @db.Decimal(12, 2)
  observations String?

  chantier   Chantier        @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  diagnostic DiagnosticBati? @relation(fields: [diagnosticId], references: [id])

  @@index([chantierId, statut])
  @@map("travaux_conservatoires")
}

enum TravailConservatoireStatut {
  A_FAIRE
  EN_COURS
  REALISE
  ANNULE
}

model TraceBati {
  id          String        @id @default(uuid())
  chantierId  String        @map("chantier_id")
  type        TraceBatiType
  zone        String
  description String
  donnees     Json?
  createdById String        @map("created_by_id")
  createdAt   DateTime      @default(now()) @map("created_at")

  chantier  Chantier @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  createdBy User     @relation(fields: [createdById], references: [id])

  @@index([chantierId, createdAt])
  @@map("traces_bati")
}

enum TraceBatiType {
  CONSTAT
  SONDAGE
  DEPOSE
  DECOUVERTE
  MODIFICATION
  CONSERVATION
  REEMPLOI
}

// ==================== DEVIS ====================
model Devis {
  id              String      @id @default(uuid())
  numero          String      @unique
  clientId        String      @map("client_id")
  chantierId      String?     @map("chantier_id")
  apporteurId     String?     @map("apporteur_id")
  referenceMandat String?     @map("reference_mandat")
  objet           String
  date            DateTime    @default(now())
  dateValidite    DateTime    @map("date_validite")
  tauxTva         Decimal     @default(20.00) @map("taux_tva") @db.Decimal(5, 2)
  totalHt         Decimal     @default(0) @map("total_ht") @db.Decimal(12, 2)
  totalTva        Decimal     @default(0) @map("total_tva") @db.Decimal(12, 2)
  totalTtc        Decimal     @default(0) @map("total_ttc") @db.Decimal(12, 2)
  conditions      String?
  statut          DevisStatut @default(BROUILLON)
  createdById     String      @map("created_by_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  dpgfId          String?     @unique @map("dpgf_id")

  client    Client             @relation(fields: [clientId], references: [id])
  chantier  Chantier?          @relation(fields: [chantierId], references: [id])
  apporteur ApporteurAffaires? @relation(fields: [apporteurId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  lignes    LigneDevis[]
  dpgf      Dpgf?              @relation(fields: [dpgfId], references: [id])
  facture   Facture?

  @@map("devis")
}

enum DevisStatut {
  BROUILLON
  ENVOYE
  RELANCE
  ACCEPTE
  REFUSE
  TRANSFORME
  EXPIRE
}

model LigneDevis {
  id             String  @id @default(uuid())
  devisId        String  @map("devis_id")
  ordre          Int     @default(0)
  designation    String
  unite          String?
  quantite       Decimal @db.Decimal(10, 2)
  prixUnitaireHt Decimal @map("prix_unitaire_ht") @db.Decimal(12, 2)
  totalHt        Decimal @map("total_ht") @db.Decimal(12, 2)

  devis Devis @relation(fields: [devisId], references: [id], onDelete: Cascade)

  @@map("lignes_devis")
}

// Fondation V1 pour les DPGF et métrés. Les endpoints métier restent à implémenter.
model Dpgf {
  id                       String     @id @default(uuid())
  reference                String     @unique
  nom                      String
  chantierId               String     @map("chantier_id")
  statut                   DpgfStatut @default(BROUILLON)
  version                  Int        @default(1)
  coefficientFraisGeneraux Decimal    @default(1) @map("coefficient_frais_generaux") @db.Decimal(8, 4)
  coefficientMarge         Decimal    @default(1) @map("coefficient_marge") @db.Decimal(8, 4)
  totalDebourseSec         Decimal    @default(0) @map("total_debourse_sec") @db.Decimal(14, 2)
  totalVenteHt             Decimal    @default(0) @map("total_vente_ht") @db.Decimal(14, 2)
  createdById              String     @map("created_by_id")
  createdAt                DateTime   @default(now()) @map("created_at")
  updatedAt                DateTime   @updatedAt @map("updated_at")

  chantier  Chantier           @relation(fields: [chantierId], references: [id], onDelete: Cascade)
  createdBy User               @relation(fields: [createdById], references: [id])
  lots      LotDpgf[]
  devis     Devis?
  analyses  AnalyseChiffrage[]

  @@index([chantierId])
  @@map("dpgf")
}

model AnalyseChiffrage {
  id              String   @id @default(uuid())
  dpgfId          String   @map("dpgf_id")
  requestedById   String   @map("requested_by_id")
  engineVersion   String   @map("engine_version")
  scoreCompletude Int      @map("score_completude")
  alertes         Json
  suggestions     Json
  comparaison     Json
  createdAt       DateTime @default(now()) @map("created_at")

  dpgf        Dpgf @relation(fields: [dpgfId], references: [id], onDelete: Cascade)
  requestedBy User @relation(fields: [requestedById], references: [id])

  @@index([dpgfId, createdAt])
  @@map("analyses_chiffrage")
}

enum DpgfStatut {
  BROUILLON
  VALIDE
  ARCHIVE
}

model LotDpgf {
  id          String  @id @default(uuid())
  dpgfId      String  @map("dpgf_id")
  code        String
  designation String
  ordre       Int     @default(0)
  parentId    String? @map("parent_id")

  dpgf     Dpgf        @relation(fields: [dpgfId], references: [id], onDelete: Cascade)
  postes   PosteDpgf[]
  parent   LotDpgf?    @relation("SousLots", fields: [parentId], references: [id], onDelete: Cascade)
  sousLots LotDpgf[]   @relation("SousLots")

  @@unique([dpgfId, code])
  @@index([dpgfId, ordre])
  @@index([parentId])
  @@map("lots_dpgf")
}

model PosteDpgf {
  id                  String        @id @default(uuid())
  lotId               String        @map("lot_id")
  code                String
  designation         String
  unite               String
  quantite            Decimal       @default(0) @db.Decimal(12, 3)
  prixUnitaireHt      Decimal       @default(0) @map("prix_unitaire_ht") @db.Decimal(12, 2)
  debourseUnitaire    Decimal       @default(0) @map("debourse_unitaire") @db.Decimal(12, 2)
  coefficientVente    Decimal       @default(1) @map("coefficient_vente") @db.Decimal(8, 4)
  margeUnitaire       Decimal       @default(0) @map("marge_unitaire") @db.Decimal(12, 2)
  totalDebourse       Decimal       @default(0) @map("total_debourse") @db.Decimal(14, 2)
  totalVenteHt        Decimal       @default(0) @map("total_vente_ht") @db.Decimal(14, 2)
  tempsUnitaireHeures Decimal?      @map("temps_unitaire_heures") @db.Decimal(8, 3)
  type                PosteDpgfType @default(BASE)
  isSelected          Boolean       @default(true) @map("is_selected")
  ouvrageId           String?       @map("ouvrage_id")
  ordre               Int           @default(0)

  lot     LotDpgf  @relation(fields: [lotId], references: [id], onDelete: Cascade)
